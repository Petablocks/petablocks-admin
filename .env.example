# ── PETABLOCKS Admin Portal Environment Configuration ─────────────────
PORT=3000
NODE_ENV=production

# Database Connection (MariaDB on cluster)
DATABASE_URL=mysql://petablocks_user:password@10.20.110.117:3307/petablocks
MC_DATABASE_URL=mysql://petablocks_user:password@10.20.110.117:3307/petablocks

# Cluster Authentication & Security
API_SECRET_TOKEN=change-this-to-a-secure-random-64-char-token
MC_SSH_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----"
# Or provide a local path:
# MC_SSH_KEY_FILE=/path/to/id_ed25519_petablocks_mcs

# Cluster Node Addresses
MC_MCS1_HOST=10.20.110.118
MC_MCS1_PORT=22
MC_MCS1_USER=root

MC_MCS2_HOST=10.20.110.119
MC_MCS2_PORT=22
MC_MCS2_USER=root

MC_MCS3_HOST=10.20.110.120
MC_MCS3_PORT=22
MC_MCS3_USER=root

MC_FEA_HOST=10.20.110.116
MC_FEA_PORT=22
